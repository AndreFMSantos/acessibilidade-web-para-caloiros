---
import '../styles.css';
import { cataloguePath } from '../lib/versions';
interface Props { title?: string; description?: string; gameId?: string }
const {
  title = 'Checkpoint — O teu próximo jogo',
  description = 'Checkpoint: loja de videojogos de demonstração para a aula de acessibilidade no ISEC.',
  gameId,
} = Astro.props;
const catalogue = cataloguePath();
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body data-game-id={gameId}>
    <a class="skip-link" href="#main-content">Saltar para o conteúdo</a>
    <header class="shell site-header">
      <a class="brand" href={catalogue} aria-label="Checkpoint — início">CHECKPOINT<span aria-hidden="true">↗</span></a>
      <nav aria-label="Principal"><a href={`${catalogue}#catalogue`}>Explorar jogos</a><button type="button" id="open-cart" aria-label="Abrir carrinho"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M3 3h2l3 12h10l3-9H6" /><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /></svg><span data-cart-count aria-hidden="true">0</span></button></nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="shell footer"><p class="brand">CHECKPOINT↗</p><p>Loja de demonstração · ISEC<br />Preços e ofertas fictícios. Não são efetuados pagamentos.</p><p>Imagens dos respetivos titulares.<br />Sem relação comercial com as editoras.</p></footer>
    <dialog id="cart" aria-labelledby="cart-title">
      <div class="dialog-heading"><h2 id="cart-title">O teu carrinho</h2><button type="button" id="close-cart">Fechar</button></div>
      <ul id="cart-items"></ul><p id="cart-total"></p><p class="demo-note">Demonstração: não existe pagamento.</p>
    </dialog>
    <script>import '../scripts/store';</script>
  </body>
</html>
