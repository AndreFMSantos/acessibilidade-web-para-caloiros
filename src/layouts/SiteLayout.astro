---
import '../styles.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CartDialog from '../components/CartDialog.astro';
import { cataloguePath } from '../lib/versions';
interface Props { title?: string; description?: string; gameId?: string }
const {
  title = 'Checkpoint — O teu próximo jogo',
  description = 'Checkpoint: loja de videojogos de demonstração para a aula de acessibilidade no ISEC.',
  gameId,
} = Astro.props;
const catalogue = cataloguePath();
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body data-game-id={gameId}>
    <a class="skip-link" href="#main-content">Saltar para o conteúdo</a>
    <SiteHeader catalogue={catalogue} />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <CartDialog />
    <script>import '../scripts/store';</script>
  </body>
</html>
