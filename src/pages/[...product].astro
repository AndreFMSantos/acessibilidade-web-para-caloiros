---
import ProductDetail from '../components/ProductDetail.astro';
import seed from '../../data/seed.json';
import { productPath } from '../lib/versions';

export function getStaticPaths() {
  return seed.games.map((game) => ({
    params: { product: productPath(game.id).slice(1) },
    props: { game },
  }));
}
---
<ProductDetail {...Astro.props} />
