---
import PlatformFilter from './PlatformFilter.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { productPath } from '../lib/versions';
---
<SiteLayout>
      <section class="shell hero" aria-labelledby="hero-title">
        <p class="eyebrow">UM JOGO. OUTRO MUNDO.</p>
        <h1 id="hero-title">O teu próximo<br />«só mais uma».</h1>
        <p class="lead">Da próxima expedição à última tentativa.<br />Encontra o jogo para a tua plataforma.</p>
        <a class="hero-link" href="#catalogue">Encontrar o próximo jogo <span aria-hidden="true">↓</span></a>
        <div class="hero-art"><a href={productPath('gta-vi-ps5')} aria-label="Ver Grand Theft Auto VI para PlayStation 5"><img src="/images/gta-vi.jpg" alt="Arte promocional de Grand Theft Auto VI" width="2560" height="1440" fetchpriority="high" /></a><p>EM DESTAQUE <strong>Grand Theft Auto VI</strong><span>Bem-vindo a Leonida.</span></p></div>
      </section>
      <section class="shell catalogue" id="catalogue" aria-labelledby="catalogue-title">
        <div class="section-heading"><h2 id="catalogue-title">Escolhe a próxima aventura.</h2><span class="eyebrow">SELEÇÃO CHECKPOINT / 2026</span></div>
        <div class="toolbar">
          <div class="search"><label for="search">Pesquisar jogos</label><input id="search" type="search" placeholder="Nome do jogo" /></div>
          <PlatformFilter />
          <div><label for="sort">Ordenar por</label><select id="sort"><option value="featured">Em destaque</option><option value="price">Preço mais baixo</option></select></div>
        </div>
        <p id="results" role="status">A carregar o catálogo…</p>
        <ul class="games" id="games"></ul>
        <p id="empty" hidden>Não encontrámos jogos com essa pesquisa. Experimenta outra plataforma ou outro nome.</p>
        <p id="cart-status" ></p>
        <p id="api-error" role="alert" hidden></p>
      </section>

</SiteLayout>
