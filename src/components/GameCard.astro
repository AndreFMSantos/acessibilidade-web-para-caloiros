---
import { formatPrice } from '../lib/format';
import type { Game } from '../lib/types';
import { productPath } from '../lib/versions';

interface Props {
  game: Game;
}
const { game } = Astro.props;
const href = productPath(game.id);
---

<li data-game-card={game.id} hidden>
  <article>
    <!-- A capa repete o link do título: fica fora do Tab e da árvore de acessibilidade, mas continua clicável. -->
    <!-- biome-ignore lint/a11y/useAnchorContent: Link duplicado, escondido de propósito (o título faz o mesmo). -->
    <a href={href} tabindex="-1" aria-hidden="true" data-game-cover>
      <img
        src={game.image}
        alt=""
        width="460"
        height="215"
        loading="lazy"
        style={`view-transition-name: cover-${game.id}`}
      >
    </a>
    <div class="game-meta">
      <p class="game-category" data-game-category>{game.platform} / {game.genre}</p>
      <h3><a href={href} data-game-title>{game.title}</a></h3>
      <div class="purchase">
        <p class="price" data-game-price>{formatPrice(game.price)}</p>
        <button
          type="button"
          data-add-game={game.id}
          aria-label={`Adicionar ao carrinho: ${game.title}`}
          disabled
        >
          Adicionar ao carrinho
        </button>
      </div>
    </div>
  </article>
</li>
