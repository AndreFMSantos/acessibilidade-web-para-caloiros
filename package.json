{
  "name": "checkpoint-isec-a11y",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev --host 127.0.0.1 --ignore-lock",
    "api": "json-server data/db.json --host 127.0.0.1 --port 3001",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "reset": "node scripts/reset.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check ."
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "^1.65.1",
    "json-server": "0.17.4",
    "typescript": "^6.0.3"
  }
}
